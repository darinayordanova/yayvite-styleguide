{
  "name": "@yayvite/styleguide",
  "version": "0.2.1",
  "description": "Yayvite design system & component library",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darinayordanova/yayvite-styleguide.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/css/yayvite.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./utilities.css": "./dist/css/utilities.css",
    "./components.css": "./dist/css/components.css",
    "./icons.css": "./dist/css/icons.css",
    "./fonts.css": "./dist/css/fonts.css",
    "./scss/*": "./dist/scss/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "patch-package",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "build:js": "vite build && tsc -p tsconfig.build.json",
    "build:css": "node scripts/build-css.mjs",
    "build": "npm run icons && npm run fonts && npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit",
    "storybook": "npm run icons && npm run fonts && storybook dev -p 6006",
    "build-storybook": "npm run icons && npm run fonts && storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fantasticon": "^4.1.0",
    "lightningcss": "^1.33.0",
    "oslllo-svg-fixer": "^6.0.1",
    "patch-package": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
